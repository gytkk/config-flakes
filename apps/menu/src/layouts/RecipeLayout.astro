---
import BaseLayout from "./BaseLayout.astro";
import { tagSlug } from "../lib/recipes";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  id: string;
  cover?: string;
  coverAlt?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  tags,
  id,
  cover,
  coverAlt,
} = Astro.props;
---

<BaseLayout
  title={`${title} | Menu by pylv`}
  description={description}
  canonicalPath={`/recipes/${id}/`}
>
  <article>
    <header>
      <p>
        <time datetime={publishedAt.toISOString()}
          >{publishedAt.toLocaleDateString("en-CA")}</time
        >
      </p>
      <h1>{title}</h1>
      <p>{description}</p>
      {cover && <img src={cover} alt={coverAlt} />}
      {
        updatedAt && (
          <p>
            <small>
              Updated{" "}
              <time datetime={updatedAt.toISOString()}>
                {updatedAt.toLocaleDateString("en-CA")}
              </time>
            </small>
          </p>
        )
      }
    </header>
    <slot />
    {
      tags.length > 0 && (
        <footer>
          <h2>Tags</h2>
          <ul class="tag-list">
            {tags.map((tag: string) => (
              <li>
                <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</BaseLayout>
