{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trade Engine Advisor Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "observations",
    "risks",
    "next_actions",
    "rationale",
    "evidence",
    "proposals"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "observations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "next_actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "detail"],
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 100
          },
          "detail": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_type",
          "symbol",
          "quantity",
          "order_type",
          "limit_price",
          "confidence",
          "time_horizon",
          "reason",
          "risk_notes"
        ],
        "properties": {
          "decision_type": {
            "type": "string",
            "enum": ["buy", "sell", "hold"]
          },
          "symbol": {
            "type": "string"
          },
          "quantity": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "order_type": {
            "type": ["string", "null"],
            "enum": ["market", "limit", null]
          },
          "limit_price": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "confidence": {
            "type": "string",
            "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
          },
          "time_horizon": {
            "type": ["string", "null"]
          },
          "reason": {
            "type": "string",
            "maxLength": 512
          },
          "risk_notes": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
