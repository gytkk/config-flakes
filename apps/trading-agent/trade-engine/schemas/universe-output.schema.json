{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trade Engine Universe Discovery Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "candidates"],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "candidates": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "bucket",
          "signals",
          "evidence",
          "risk_flags",
          "target_support",
          "reason",
          "confidence"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "bucket": {
            "type": "string",
            "enum": [
              "liquidity",
              "valuation",
              "short_term_momentum",
              "catalyst",
              "watchlist_peer",
              "defensive_rotation",
              "etf_or_proxy",
              "target_price_gap"
            ]
          },
          "target_support": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["source_count", "consensus", "freshness"],
            "properties": {
              "source_count": {
                "type": ["integer", "null"],
                "minimum": 1
              },
              "consensus": {
                "type": ["boolean", "null"]
              },
              "freshness": {
                "type": ["string", "null"],
                "enum": ["fresh", "recent", "stale", null]
              }
            }
          },
          "signals": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "volume_leader",
                "trading_value_leader",
                "relative_low_per",
                "relative_low_pbr",
                "roe_support",
                "volume_breakout",
                "price_breakout",
                "relative_strength",
                "earnings_catalyst",
                "news_catalyst",
                "policy_catalyst",
                "watchlist_peer",
                "defensive_rotation",
                "macro_sensitive",
                "etf_proxy",
                "holding_company_proxy",
                "analyst_target_upside",
                "consensus_target_upside",
                "target_price_revision"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "value", "as_of", "source"],
              "properties": {
                "metric": {
                  "type": "string",
                  "maxLength": 400
                },
                "value": {
                  "type": "string",
                  "maxLength": 400
                },
                "as_of": {
                  "type": "string",
                  "maxLength": 400
                },
                "source": {
                  "type": "string",
                  "maxLength": 400
                }
              }
            }
          },
          "risk_flags": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "stale_data",
                "unverified_source",
                "news_unverified",
                "thin_liquidity",
                "high_volatility",
                "event_risk",
                "crowded_trade",
                "gap_risk",
                "data_unavailable",
                "stale_target_price",
                "single_broker_target"
              ]
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          },
          "confidence": {
            "type": "string",
            "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
          }
        }
      }
    }
  }
}
