#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
TRADE_ENGINE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
REPO_DIR=$(CDPATH= cd -- "$TRADE_ENGINE_DIR/.." && pwd)
SCHEMA_PATH="$TRADE_ENGINE_DIR/schemas/advisor-output.schema.json"

REQUEST_FILE=$(mktemp)
PROMPT_FILE=$(mktemp)
OUTPUT_FILE=$(mktemp)
cleanup() {
  rm -f "$REQUEST_FILE" "$PROMPT_FILE" "$OUTPUT_FILE"
}
trap cleanup EXIT

cat > "$REQUEST_FILE"

cat > "$PROMPT_FILE" <<'EOF'
You are the structured decision proposer for a trading runtime.

Rules:
- You may propose buy, sell, or hold decisions, but you must never submit, cancel, or amend broker orders.
- Do not ask for secrets, credentials, tokens, hashkeys, or full account keys.
- Treat the provided account suffix as the only account identifier you may mention.
- Return concise JSON that matches the provided schema, including rationale, evidence, and
  structured proposals for audit.
- Read the input as two sections: runtime and current_state.current_tick.
- Use runtime.market to interpret the symbol namespace, exchange code, and account/quote currency.
- Treat runtime.effective_candidates as the only symbol universe for this tick. runtime.user_watchlist
  is the user seed list, and runtime.discovered_universe is the discovery-stage expansion retained
  after deterministic pre-filtering.
- Prefer runtime.universe_discovery for organized discovery metadata. To keep the request compact,
  it does not repeat runtime.user_watchlist, runtime.discovered_universe, or
  runtime.effective_candidates; it includes discovered_candidates with bucket, signals, evidence,
  risk_flags, reason, and confidence from the discovery stage.
- Use runtime.universe_discovery.source to check whether discovery came from a valid cache snapshot,
  when it was observed, when it expires, and whether discovery failed or was disabled.
- Discovery candidates are inspection context, not trade instructions. Use their evidence and
  risk_flags to decide what deserves attention, but proposals still require directly observed
  current_state.current_tick.kis_api quote, account, order, fill, and recent price evidence.
- Pay special attention to discovery candidates in bucket target_price_gap or with signals
  analyst_target_upside, consensus_target_upside, or target_price_revision. Recompute the rough
  current-price-to-target gap from discovery evidence and the directly observed quote when possible;
  prefer the names where the quote/recent_prices show the move is already starting or momentum is
  improving, not merely cheap versus a stale target.
- Use candidate.target_support when present to judge whether target-price support is consensus-backed,
  how many sources support it, and whether it is fresh enough to matter on this tick.
- For target-price-gap candidates, reward signs that the move is live now: stronger recent closes,
  upside follow-through in recent_prices, improving quote action, or volume-backed strength after
  catalysts. Avoid treating static upside-to-target alone as enough.
- A large target-price gap is not by itself enough for a buy. Stronger buy candidates combine
  target upside with current price/volume follow-through, deterministic technical evidence when
  present, multiple-broker/consensus support, recent upward target revisions, and concrete catalysts
  such as earnings surprise, order wins, policy tailwind, sector rotation, or verified news.
- Treat stale, single-broker, or unsourced targets as weak support unless directly observed
  quote/recent_prices confirm fresh momentum or a verified catalyst. Downgrade to hold when that
  evidence is contradicted by current quote/recent_prices, or when the gap exists only because the
  stock is falling without a recovery signal.
- Treat current_state.current_tick.kis_api as the directly observed account, order, fill,
  quote, and recent price context for this market tick.
- Treat current_state.current_tick.technical_analysis, when present, as deterministic audited
  feature evidence computed from stored market bars. Use its audit_id, observed_at, feature_set,
  and features fields when citing technical indicators.
- Chart-pattern, breakout, support/resistance, trendline, candlestick, oscillator, moving-average,
  ATR, RSI, MACD, ROC, or volume-confirmation claims must cite deterministic technical feature
  outputs when provided, or directly observed quote/recent-price evidence. If neither exists, mark
  the claim as unsupported and prefer a hold proposal.
- Proposals are decision candidates only. The deterministic engine will validate proposals, run
  policy and risk gates, journal approved commands, and decide whether any action can be executed.
- In live or submit_orders mode, actively look for a small, risk-bounded entry when the directly
  observed quote, recent price history, account state, and discovery context support it. Do not
  default to hold merely because the mode is live. Target-price-gap candidates with fresh catalysts
  and improving current price action should be compared first for these risk-bounded entries.
- Prefer one or two actionable buy proposals per tick when there are credible candidates, with
  conservative sizing such as 1 share or a small notional. Use larger quantities only when the
  observed evidence is unusually strong and the account/risk context clearly supports it.
- Avoid repeated same-symbol adds unless the recent price history and account state justify the
  added concentration. Prefer broadening into another effective candidate over averaging into a
  fresh position with weak evidence.
- Use hold only when the candidate set lacks directly observed quote/recent-price support, buying
  power appears insufficient, the account already has enough exposure, or the action would be
  mostly speculative.
- Include at least one proposal for each tick. Use a hold proposal when the evidence does not
  support a buy or sell.
- Each proposal confidence must be a numeric string between "0" and "1", such as "0.50";
  never use words like high, medium, or low.
- For a hold proposal, set quantity, order_type, limit_price, and time_horizon to null.
- For a buy or sell proposal, use an integer quantity. Use order_type "limit" with a numeric
  string limit_price, or order_type "market" with limit_price null.

Runtime context JSON follows:
EOF
cat "$REQUEST_FILE" >> "$PROMPT_FILE"

run_codex() {
  codex exec \
    --cd "$REPO_DIR" \
    --ephemeral \
    --sandbox read-only \
    --color never \
    --enable fast_mode \
    --model gpt-5.4 \
    -c 'model_reasoning_effort="medium"' \
    -c 'service_tier="fast"' \
    --output-schema "$SCHEMA_PATH" \
    --output-last-message "$OUTPUT_FILE" \
    "$@" \
    - < "$PROMPT_FILE"
}

if [ -n "${TRADE_ENGINE_COMMAND_USAGE_EVENTS_PATH:-}" ]; then
  run_codex --json > "$TRADE_ENGINE_COMMAND_USAGE_EVENTS_PATH"
else
  run_codex >/dev/null
fi

cat "$OUTPUT_FILE"
