{
  config,
  lib,
  pkgs,
  flakeDirectory,
  themeExports,
  ...
}:

let
  cfg = config.modules.pi;
  agentCoreOutput = import ../../agent-core/nix/render.nix { inherit pkgs; } { runtime = "pi"; };
  mkSymlink = path: config.lib.file.mkOutOfStoreSymlink "${flakeDirectory}/modules/pi/${path}";

  hindsightClient = import ./hindsight-client.nix { inherit pkgs; };
  hindsightEntry =
    if (cfg.hindsightTokenFile or null) == null then
      "${hindsightClient}/dist/pi.js"
    else
      pkgs.runCommand "hindsight-pi-with-sepia-token.mjs" { } ''
        substitute ${hindsightClient}/dist/pi.js "$out" \
          --replace-fail 'fetch(url2, { ...init, headers: this.headers(), ...dispatcher ? { dispatcher } : {} })' \
            'fetch(url2, sepiaRequest(this.apiUrl, url2, { ...init, headers: this.headers(), ...dispatcher ? { dispatcher } : {} }, endpoint, lanDispatcher))' \
          --replace-fail \
          'function applyBankConfig(cfg, resolvedId, directory) {' \
          ${lib.escapeShellArg ''
            import { sepiaRequest, withSepiaToken } from "${./files/hindsight-token.mjs}";
            const endpoint = ${builtins.toJSON cfg.hindsightEndpoint};
            ${
              if cfg.hindsightLan then
                ''
                  import undici from "${pkgs.pi}/lib/pi/node_modules/undici/index.js";
                  const lanDispatcher = new undici.Agent({ headersTimeout: 0, bodyTimeout: 0, connect: {
                    lookup(host, options, cb) {
                      if (host !== "hindsight.pylv.dev") return cb(new Error("Unexpected Hindsight LAN hostname"));
                      if (options.all) cb(null, [{address: "192.168.0.2", family: 4}]);
                      else cb(null, "192.168.0.2", 4);
                    }
                  } });
                ''
              else
                "const lanDispatcher = null;"
            }
            function applyBankConfig(cfg, resolvedId, directory) {
              return withSepiaToken(resolveBankConfig(cfg, resolvedId, directory), ${builtins.toJSON cfg.hindsightTokenFile}, endpoint);
            }
            function resolveBankConfig(cfg, resolvedId, directory) {''}
      '';
  hindsightPackage = ".pi/agent/packages/hindsight";
  extensionPackages = [
    "npm:@juicesharp/rpiv-ask-user-question@2.15.0"
    {
      source = "npm:@juicesharp/rpiv-todo@2.15.0";
      skills = [ ];
      prompts = [ ];
    }
    {
      source = "npm:pi-lens@4.4.12";
      skills = [ ];
      prompts = [ ];
    }
    {
      source = "npm:pi-interactive-shell@0.18.0";
      skills = [ ];
      prompts = [ ];
    }
    "npm:pi-web-access@0.46.0"
    {
      source = "npm:pi-subagents@0.84.0";
      skills = [ ];
      prompts = [ ];
    }
    {
      source = "./packages/hindsight";
      skills = [ "skills/hindsight-coding-agent/SKILL.md" ];
      extensions = [ "index.ts" ];
      prompts = [ ];
      themes = [ ];
    }
  ];

  localExtensions = {
    "auto-title.ts" = mkSymlink "files/extensions/auto-title.ts";
    "prompt-ui" = mkSymlink "files/extensions/prompt-ui";
    "codex-fast-mode.ts" = mkSymlink "files/extensions/codex-fast-mode.ts";
    "subscription-usage.ts" = mkSymlink "files/extensions/subscription-usage.ts";
    "korean-translation" = mkSymlink "files/extensions/korean-translation";
    "rounded-tools.ts" = mkSymlink "files/extensions/rounded-tools.ts";
    "python-kernel" = mkSymlink "files/extensions/python-kernel";
    "session-artifacts" = mkSymlink "files/extensions/session-artifacts";
    "agent-hub" = mkSymlink "files/extensions/agent-hub";
    "herdr-subagents.ts" = mkSymlink "files/extensions/herdr-subagents.ts";
    "terminal-title-reset.ts" = mkSymlink "files/extensions/terminal-title-reset.ts";
  }
  //
    lib.optionalAttrs
      (config.modules.agentSessionRecord.enable && config.modules.agentSessionRecord.agents.pi.enable)
      {
        "session-record.ts" = mkSymlink "files/extensions/session-record.ts";
      }
  // lib.optionalAttrs config.modules.herdr.enable {
    "herdr-agent-state.ts" = "${pkgs.herdr.src}/src/integration/assets/pi/herdr-agent-state.ts";
  };

  extensionFiles = lib.mapAttrs' (
    name: source: lib.nameValuePair ".pi/agent/extensions/${name}" { inherit source; }
  ) localExtensions;
  commonSettings = pkgs.writeText "pi-common-settings.json" (
    builtins.toJSON (
      builtins.fromJSON (builtins.readFile cfg.settingsFile) // { packages = extensionPackages; }
    )
  );
  # Nix supplies binaries; Lens must not install servers or analysis tools.
  sessionVariables = {
    PI_LENS_DISABLE_LSP_INSTALL = "1";
    PI_LENS_DISABLE_TOOL_INSTALL = "1";
  }
  # The Pi that runs lacks packages/apps/pi/patches.nix for good, so applying Home Manager cannot add what they add.
  // lib.optionalAttrs (!cfg.installPackage) { PI_UNPATCHED = "1"; };
  launchEnvironment = pkgs.writeText "launch-environment.ts" ''
    // Generated by modules/pi/default.nix. Pi's MCP servers start on session_start, after every extension has loaded,
    // and Lens reads its switches when it is about to install, so setting them here reaches both.
    const variables: Record<string, string> = ${builtins.toJSON sessionVariables};
    const pathHead: string[] = ${builtins.toJSON cfg.launchEnvironment.pathHead};

    export default function () {
      Object.assign(process.env, variables);
      const entries = [...pathHead, ...(process.env.PATH ?? "").split(":")].filter(Boolean);
      process.env.PATH = [...new Set(entries)].join(":");
    }
  '';
  syncSettings = pkgs.writeShellScript "pi-sync-settings" ''
    export PATH=${
      lib.makeBinPath (
        with pkgs;
        [
          coreutils
          jq
        ]
      )
    }:$PATH
    exec ${pkgs.bash}/bin/bash ${./files/sync-settings.sh} "$@"
  '';
in
{
  options.modules.pi = {
    hindsightEndpoint = lib.mkOption {
      type = lib.types.str;
      default = "https://pylv-sepia.tailbbb9bf.ts.net";
      description = "Private Hindsight origin for this host.";
    };
    hindsightLan = lib.mkEnableOption "direct LAN resolution for the Hindsight Pi client on denim";
    hindsightTokenFile = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      description = "Runtime agenix credential for the sepia Hindsight endpoint.";
    };

    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable Pi coding agent CLI";
    };

    installPackage = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Install Pi itself. Turn off where another installer pins the Pi that runs, such as a jari worker.";
    };

    launchEnvironment = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = ''
          Apply the module's session variables and PATH order inside Pi through an extension, for a Pi that a
          service starts with a fixed environment instead of from a login shell.
        '';
      };

      pathHead = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = "Directories moved to the front of Pi's PATH, in order, when launchEnvironment is enabled.";
      };
    };
  };

  options.modules.pi.settingsFile = lib.mkOption {
    type = lib.types.path;
    default = ./files/settings.json;
    description = "General Pi settings to merge with the managed package selection.";
  };

  config = lib.mkIf cfg.enable {
    home.packages = lib.optional cfg.installPackage pkgs.pi ++ [
      pkgs.mcp-nixos
      pkgs.python3
      pkgs.ast-grep
      (pkgs.writeShellScriptBin "pi-session-editor" ''
        export PATH="$PATH":${
          lib.makeBinPath [
            pkgs.herdr-core
            pkgs.neovim
          ]
        }
        exec ${pkgs.python3}/bin/python3 ${./files/session-editor.py} "$@"
      '')
    ];

    home.sessionVariables = sessionVariables;

    home.file =
      extensionFiles
      // lib.optionalAttrs cfg.launchEnvironment.enable {
        ".pi/agent/extensions/launch-environment.ts".source = launchEnvironment;
      }
      // {
        "${hindsightPackage}/package.json".text = builtins.toJSON {
          name = "hindsight-pi";
          pi = {
            extensions = [ "./index.ts" ];
            skills = [ "./skills/hindsight-coding-agent/SKILL.md" ];
          };
        };
        "${hindsightPackage}/skills/hindsight-coding-agent/SKILL.md".source =
          "${hindsightClient}/skill/SKILL.md";
        "${hindsightPackage}/index.ts".source = pkgs.writeText "hindsight-pi.ts" ''
          import { readFileSync } from "node:fs";
          import { homedir } from "node:os";
          import { join } from "node:path";
          import hindsight from "${hindsightEntry}";

          export default function (pi: Parameters<typeof hindsight>[0]) {
            const path = process.env.HINDSIGHT_CONFIG || join(homedir(), ".hindsight", "coding-agent.json");
            try {
              // Other harnesses share this file. Only an explicit Pi opt-in enables its hooks.
              if (JSON.parse(readFileSync(path, "utf8")).harnesses?.pi?.disabled !== false) return;
            } catch (error) {
              if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
              throw new Error(`Cannot read Hindsight configuration: ''${path}`);
            }
            return hindsight(pi);
          }
        '';
        ".pi/agent/AGENTS.md".source = "${agentCoreOutput}/AGENTS.md";
        ".pi/agent/APPEND_SYSTEM.md".source = "${agentCoreOutput}/APPEND_SYSTEM.md";
        ".pi/agent/agents/researcher.md".source = mkSymlink "agents/researcher.md";
        ".pi/agent/agents/reviewer.md".source = mkSymlink "agents/reviewer.md";
        ".pi/agent/agents/worker.md".source = mkSymlink "agents/worker.md";
        ".pi/agent/interactive-shell.json".source = mkSymlink "files/interactive-shell.json";
        ".pi-lens/config.json".source = mkSymlink "files/lens.json";
        ".pi/agent/models.json".source = mkSymlink "files/models.json";
        ".pi/web-search.json".source = mkSymlink "files/web-search.json";
        ".pi/agent/themes/one-half-light.json".source = themeExports.file "pi" "one-half-light.json";
        ".pi/agent/extensions/subagent/config.json".source =
          mkSymlink "files/extensions/subagent/config.json";
      };

    home.activation.piMcp = lib.hm.dag.entryBetween [ "linkGeneration" ] [ "writeBoundary" ] ''
      (
        export PATH=${
          lib.escapeShellArg (
            lib.concatStringsSep ":" (
              (lib.optional cfg.installPackage "${pkgs.pi}/bin")
              ++ cfg.launchEnvironment.pathHead
              ++ [
                (lib.makeBinPath [
                  pkgs.coreutils
                  pkgs.jq
                ])
              ]
            )
          )
        }:$PATH
        run ${pkgs.bash}/bin/bash ${./files/seed-mcp.sh} ${lib.escapeShellArg "${flakeDirectory}/modules/pi/files/mcp.json"}
      )
    '';

    # Preserve installation-local metadata before Home Manager removes the old symlink.
    home.activation.piSettings = lib.hm.dag.entryBetween [ "linkGeneration" ] [ "writeBoundary" ] ''
      run ${syncSettings} ${commonSettings} "$HOME/.pi/agent/settings.json"
    '';
  };
}
