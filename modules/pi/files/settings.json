{
  "theme": "one-half-light",
  "defaultProvider": "openai",
  "quietStartup": "header",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "high",
  "showCacheMissNotices": true,
  "compaction": {
    "enabled": true,
    "modelOverrides": {
      "openai/gpt-6-astra": {
        "reserveTokens": 54400,
        "keepRecentTokens": 40000
      }
    }
  },
  "subagents": {
    "defaultModel": "openai/gpt-6.1-sol",
    "defaultThinking": "medium",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai/gpt-6-luna",
        "openai/gpt-6.1-sol",
        "openai/gpt-6-astra"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "openai/gpt-6-luna",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "intercom"
        ]
      },
      "researcher": {
        "model": "openai/gpt-6-luna",
        "thinking": "low"
      },
      "worker": {
        "thinking": "medium",
        "defaultContext": "fresh"
      },
      "reviewer": {
        "thinking": "high"
      },
      "context-builder": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "web_search",
          "intercom"
        ]
      },
      "planner": {
        "model": "openai/gpt-6.1-sol",
        "defaultContext": "fresh"
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "defaultContext": "fresh"
      },
      "delegate": {
        "disabled": true
      }
    }
  },
  "powerline": {
    "preset": "default",
    "placement": "above",
    "separator": "pipe",
    "path": {
      "mode": "full"
    },
    "layout": {
      "left": ["path", "git", "context_pct"],
      "right": ["extension_statuses", "custom:weekly", "model", "thinking", "custom:fast"],
      "secondary": []
    },
    "welcome": false,
    "queue": {
      "compactPromptMode": "native"
    },
    "sendDelayMs": 0,
    "autoFollowUp": false,
    "customItems": [
      {
        "id": "weekly",
        "statusKey": "codex-usage",
        "position": "right"
      },
      {
        "id": "fast",
        "statusKey": "codex-fast-mode",
        "position": "right",
        "color": "warning"
      }
    ]
  },
  "bashMode": {
    "toggleShortcut": null,
    "completions": false
  },
  "workingVibe": "off",
  "editorPaddingX": 1,
  "outputPad": 1,
  "showHardwareCursor": true
}
