     #[test]
+    fn token_background_roundtrips_and_only_styles_token_spans() {
+        use ratatui::style::{Color, Style};
+        let config: AgentsSidebarConfig = toml::from_str(
+            r##"
+rows = [
+  [{ token = "state_icon", bg = "#383a42" }, "workspace"],
+  [{ token = "$status", rules = [{ equals = "●", fg = "#ffe600", bg = "#383a42" }] }, "workspace"],
+  [{ token = "$status", bg = "#383a42", rules = [{ equals = "●", fg = "#ffe600" }] }, "workspace"]
+]
+"##,
+        )
+        .unwrap();
+        let encoded = toml::to_string(&config).unwrap();
+        assert_eq!(
+            toml::from_str::<AgentsSidebarConfig>(&encoded).unwrap(),
+            config
+        );
+        let background = Some(Color::Rgb(56, 58, 66));
+        let mut entry = entry();
+        for status in ["●", "✓"] {
+            entry.tokens.insert("status".into(), status.into());
+            let rows = agent_rows(&config, context(&entry), "working");
+            for (index, row) in rows.iter().enumerate() {
+                let spans = super::super::resolved_token_spans(
+                    row,
+                    ("●", Style::default()),
+                    Style::default(),
+                    Style::default(),
+                    Style::default(),
+                    Style::default(),
+                    &super::super::Palette::catppuccin(),
+                    40,
+                );
+                assert_eq!(spans.len(), 3);
+                assert_eq!(
+                    spans[0].style.bg,
+                    if index == 1 && status != "●" {
+                        None
+                    } else {
+                        background
+                    }
+                );
+                if index > 0 && status == "●" {
+                    assert_eq!(spans[0].style.fg, Some(Color::Rgb(255, 230, 0)));
+                }
+                assert_eq!(spans[1].content, " ");
+                assert_eq!(spans[1].style.bg, None);
+                assert_eq!(spans[2].style.bg, None);
+                let mut buffer =
+                    ratatui::buffer::Buffer::empty(ratatui::layout::Rect::new(0, 0, 40, 1));
+                ratatui::widgets::Widget::render(
+                    ratatui::widgets::Paragraph::new(ratatui::text::Line::from(spans))
+                        .style(Style::default().bg(Color::White)),
+                    buffer.area,
+                    &mut buffer,
+                );
+                assert_eq!(
+                    buffer[(0, 0)].bg,
+                    if index == 1 && status != "●" {
+                        Color::White
+                    } else {
+                        background.unwrap()
+                    }
+                );
+                assert_eq!(buffer[(1, 0)].bg, Color::White);
+                assert_eq!(buffer[(2, 0)].bg, Color::White);
+            }
+        }
+    }
